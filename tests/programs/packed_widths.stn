// arithmetic on lists runs over groups of elements at once (two, four on x86-64 v3, eight and
// then the rest under a mask on v4, or as many as the vector length under SVE) and then one at
// a time, so every length up to two of the widest groups and a remainder gives the same elements
fn floats(n: int, k: float) -> list[float]:
    xs = []
    for i in range(n):
        xs.append(float(i) * k + 0.5)
    ret xs

fn ints(n: int, k: int) -> list[int]:
    xs = []
    for i in range(n):
        xs.append(i * k - 3)
    ret xs

for n in range(18):
    x = floats(n, 1.5)
    y = floats(n, 0.75)
    print(n, -x / y, x - y * x)
    // written over in place, since nothing else holds y's list
    y = 2.0 * x + y
    print(y)
    a = ints(n, 7)
    b = ints(n, -2)
    print(-(a - b) + a, a + 3 - b)
    // ints multiply, wrapping on overflow, in vectors where the processor can
    print(a * b - a * 3, -(a * 4611686018427387904))

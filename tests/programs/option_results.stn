// find, pop, get, and os.env give options rather than a value meaning "missing"
use os

// find
s = "banana"
print(s.find("na"), s.find("x"), "".find(""))
fn key_of(line: str) -> str:
    match line.find("="):
        case some(at):
            ret line[:at]
        case none:
            ret line
print(key_of("name=stone"), key_of("plain"))

// pop without an index, on lists of every kind of element
ints = [1, 2]
a = ints.pop()
b = ints.pop()
c = ints.pop()
print(a, b, c, ints)
strs = ["x", "y"]
t = strs.pop()
print(t, strs, t.unwrap() + "!")
lists = [[1], [2, 3]]
l = lists.pop()
print(l, lists, l.unwrap_or([]).len())
pairs = [("a", [1]), ("b", [2, 3])]
p = pairs.pop()
print(p, pairs)
match p:
    case some(pair):
        name, values = pair
        print(name, values)
    case none:
        print("empty")
empty = [("z", [0])]
empty.pop()
q = empty.pop()
print(q, empty)

struct Bag:
    items: list[str]
bags = [Bag(items=["one"]), Bag(items=["two", "three"])]
top = bags.pop()
print(top, bags)
bags[0].items.pop()
inner = bags[0].items.pop()
print(inner, bags)
grid = [[1, 2], []]
x = grid[0].pop()
y = grid[1].pop()
print(x, y, grid)

// a function pops from its own copy and returns it
fn drop_last(xs: list[int]) -> list[int]:
    last = xs.pop()
    print("dropped", last)
    ret xs
print(drop_last([4, 5]), drop_last([]))

// get
ages = {"ann": 31, "bo": 22}
print(ages.get("ann"), ages.get("cy"), ages)
flags = {true: [1, 2], false: []}
print(flags.get(true), flags.get(false))
named = {1: ("one", [1.5])}
print(named.get(1), named.get(2), {"k": "v"}.get("k"))
fn age(name: str) -> int:
    ret ages.get(name).unwrap_or(-1)
print(age("bo"), age("dee"))

// os.env
print(os.env("STONE_OPTION_SET"), os.env("STONE_OPTION_UNSET"))
home = os.env("STONE_OPTION_SET").unwrap_or("nowhere")
print(home, os.env("STONE_OPTION_UNSET").unwrap_or("nowhere"))

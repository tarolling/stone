// reads every line, including empty ones and a last line with no newline
name = input("name? ").unwrap()
print("hello, " + name)
count = 0
while not eof():
    line = input().unwrap()
    count = count + 1
    print(count, "[" + line + "]", line.len())
// past the end, input returns an err
print(eof(), input().is_err(), eof())

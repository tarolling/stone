// The prelude, which every program is linked with, so its names need no `use`. Its variants are
// written alone, as `some(x)`, `none`, and `less`, and print that way too. Its functions are
// linked as `prelude.<name>`, so a program's names never clash with them.
//
// Builtins such as `find`, `pop`, `get`, and `os.env` make options by tag, so `none` stays the
// first variant and `some` the second, `cmp` on builtin types makes orderings by tag, so `less`,
// `equal`, and `greater` stay in that order, and `parse_int` and `parse_float` make results by
// tag, so `ok` stays before `err`. `os.run` fills an `output` by field order, so `status`,
// `stdout`, and `stderr` stay in that order.

// A value that may be missing: `some(x)` holds one, and `none` holds nothing.
pub enum option[T]:
    none
    some(T)

// How one value compares with another, which `cmp` gives.
pub enum ordering:
    less
    equal
    greater

// The outcome of something that may fail: `ok(x)` holds its value, and `err(e)` the error. `?`
// after a result gives the value of an `ok`, and returns an `err` from the function it is in.
pub enum result[T, E]:
    ok(T)
    err(E)

// What a command `os.run` ran did: the status it exited with (or minus the number of the signal
// that stopped it), and the text it wrote to stdout and to stderr.
pub struct output:
    status: int
    stdout: str
    stderr: str

// Values that `==` and `!=` compare. Every type `==` compares part by part implements it, and a
// struct may define what `==` means for it instead, as in `impl eq for Point:`.
pub trait eq:
    fn eq(self, other: Self) -> bool

// Values in an order, which `<`, `<=`, `>`, `>=`, and `sort` use. `int`, `float`, and `str`
// implement it, and a struct may too, as in `impl ord for Version:`.
pub trait ord:
    fn cmp(self, other: Self) -> ordering

// Values that `print`, `str`, and a string's `{value}` write as text. Every type implements it,
// and a struct may say how it is written instead, as in `impl display for Point:`, which `print`
// and `str` then use wherever a `Point` appears, inside lists and other values too.
pub trait display:
    fn display(self) -> str

// How a value of type `T` becomes a value of the implementing type, which `Type(value)` calls,
// as in `Fahrenheit(c)` after `impl from[Celsius] for Fahrenheit:`. Every type converts from
// itself, every value to `str` through `display`, and an `int` to a `float`.
pub trait from[T]:
    fn from(value: T) -> Self

// How a value of type `T` may become a value of the implementing type, which `Type(value)`
// calls, giving the error if it cannot, as `int("12")` gives `ok(12)` and `int("x")` an `err`.
// A `float` or a `str` may become an `int`, a `str` a `float`, and a `list[int]` `bytes`.
pub trait try_from[T]:
    fn try_from(value: T) -> result[Self, str]

// Sorts a list of values of a type that implements `ord`, for `xs.sort()` on a list of anything
// but `int`, `float`, and `str`. It merges ever longer runs, taking from the right run only when
// its value is less than the left's, so equal values keep their order, and every program gets
// the same list from the same `cmp`.
fn sort[T: ord](xs: list[T]) -> list[T]:
    n = xs.len()
    width = 1
    while width < n:
        out = []
        start = 0
        while start < n:
            mid = start + width
            if mid > n:
                mid = n
            end = mid + width
            if end > n:
                end = n
            i = start
            j = mid
            while i < mid and j < end:
                if xs[j] < xs[i]:
                    out.append(xs[j])
                    j += 1
                else:
                    out.append(xs[i])
                    i += 1
            while i < mid:
                out.append(xs[i])
                i += 1
            while j < end:
                out.append(xs[j])
                j += 1
            start = end
        xs = out
        width *= 2
    ret xs

// The list of what `f` gives for each value of `xs`, in order, for `xs.map(f)`.
fn map[T, U](xs: list[T], f: fn(T) -> U) -> list[U]:
    out = []
    for x in xs:
        out.append(f(x))
    ret out

// The values of `xs` that `keep` gives true for, in order, for `xs.filter(keep)`.
fn filter[T](xs: list[T], keep: fn(T) -> bool) -> list[T]:
    out = []
    for x in xs:
        if keep(x):
            out.append(x)
    ret out

// Whether `test` gives true for any value of `xs`, trying them in order until one does, for
// `xs.any(test)`.
fn any[T](xs: list[T], test: fn(T) -> bool) -> bool:
    for x in xs:
        if test(x):
            ret true
    ret false

// Whether `test` gives true for every value of `xs`, trying them in order until one does not,
// for `xs.all(test)`.
fn all[T](xs: list[T], test: fn(T) -> bool) -> bool:
    for x in xs:
        if not test(x):
            ret false
    ret true

// Sorts `xs` by what `key` gives for each value, for `xs.sort_by_key(key)`. It calls `key` once
// for each value, in order, then merges ever longer runs of their positions as `sort` merges
// values, so values with equal keys keep their order.
fn sort_by_key[T, K: ord](xs: list[T], key: fn(T) -> K) -> list[T]:
    keys = []
    order = []
    n = 0
    for x in xs:
        keys.append(key(x))
        order.append(n)
        n += 1
    width = 1
    while width < n:
        out = []
        start = 0
        while start < n:
            mid = start + width
            if mid > n:
                mid = n
            end = mid + width
            if end > n:
                end = n
            i = start
            j = mid
            while i < mid and j < end:
                if keys[order[j]] < keys[order[i]]:
                    out.append(order[j])
                    j += 1
                else:
                    out.append(order[i])
                    i += 1
            while i < mid:
                out.append(order[i])
                i += 1
            while j < end:
                out.append(order[j])
                j += 1
            start = end
        order = out
        width *= 2
    sorted = []
    for position in order:
        sorted.append(xs[position])
    // `xs.sort_by_key(key)` moves the list in for its sorted copy, so this owns it, as `sort` does
    xs = sorted
    ret xs

// The first value of `xs` with the least key, or none if `xs` is empty, for
// `xs.min_by_key(key)`, which calls `key` once for each value, in order.
fn min_by_key[T, K: ord](xs: list[T], key: fn(T) -> K) -> option[T]:
    if xs.len() == 0:
        ret none
    best = 0
    best_key = key(xs[0])
    for i in range(1, xs.len()):
        k = key(xs[i])
        if k < best_key:
            best = i
            best_key = k
    ret some(xs[best])

// The last value of `xs` with the greatest key, or none if `xs` is empty, for
// `xs.max_by_key(key)`, so it is the value `sort_by_key` puts last.
fn max_by_key[T, K: ord](xs: list[T], key: fn(T) -> K) -> option[T]:
    if xs.len() == 0:
        ret none
    best = 0
    best_key = key(xs[0])
    for i in range(1, xs.len()):
        k = key(xs[i])
        if k >= best_key:
            best = i
            best_key = k
    ret some(xs[best])

// The lesser of `a` and `b`, for `a.min(b)`: `b` only if it is less than `a`, so of equal values
// it is `a`, as `math.min` keeps the first.
fn min[T: ord](a: T, b: T) -> T:
    if b < a:
        ret b
    ret a

// The greater of `a` and `b`, for `a.max(b)`: `b` only if it is greater than `a`, so of equal
// values it is `a`, as `math.max` keeps the first.
fn max[T: ord](a: T, b: T) -> T:
    if b > a:
        ret b
    ret a

// Whether `lo` is at most `hi` (never for a nan bound), then `x` brought into the range from `lo`
// to `hi`, for `x.clamp(lo, hi)`, which turns bounds out of order into a runtime error. A tuple
// rather than an option, so a call allocates nothing.
fn clamp[T: ord](x: T, lo: T, hi: T) -> tuple[bool, T]:
    if not (lo <= hi):
        ret (false, x)
    if x < lo:
        ret (true, lo)
    if x > hi:
        ret (true, hi)
    ret (true, x)

// Reduces `x`, a finite float of at least 2^20 * pi/2, by pi/2 for `math.sin`, `math.cos`, and
// `math.tan`, which reduce smaller ones themselves: the number of quarter turns in `x` modulo 8,
// then the rest as two floats whose sum it is, at most about pi/4 from 0. It is musl's
// `__rem_pio2_large` (Payne and Hanek's method, from fdlibm), which multiplies `x` by just the
// bits of 2/pi that matter, 24 at a time. Every float holds a whole number below 2^53 until the
// end, so every step is exact, and `v - v % 1.0` cuts off a fraction, so nothing is allocated.
fn rem_pio2_large(x: float) -> tuple[float, float, float]:
    // 2/pi, 24 bits at a time, and pi/2 the same way
    ipio2 = [10680707.0, 7228996.0, 1387004.0, 2578385.0, 16069853.0, 12639074.0, 9804092.0]
    ipio2.extend([4427841.0, 16666979.0, 11263675.0, 12935607.0, 2387514.0, 4345298.0, 14681673.0])
    ipio2.extend([3074569.0, 13734428.0, 16653803.0, 1880361.0, 10960616.0, 8533493.0, 3062596.0])
    ipio2.extend([8710556.0, 7349940.0, 6258241.0, 3772886.0, 3769171.0, 3798172.0, 8675211.0])
    ipio2.extend([12450088.0, 3874808.0, 9961438.0, 366607.0, 15675153.0, 9132554.0, 7151469.0])
    ipio2.extend([3571407.0, 2607881.0, 12013382.0, 4155038.0, 6285869.0, 7677882.0, 13102053.0])
    ipio2.extend([15825725.0, 473591.0, 9065106.0, 15363067.0, 6271263.0, 9264392.0, 5636912.0])
    ipio2.extend([4652155.0, 7056368.0, 13614112.0, 10155062.0, 1944035.0, 9527646.0, 15080200.0])
    ipio2.extend([6658437.0, 6231200.0, 6832269.0, 16767104.0, 5075751.0, 3212806.0, 1398474.0])
    ipio2.extend([7579849.0, 6349435.0, 12618859.0])
    pio2 = [1.570796251296997, 7.549789415861596e-08, 5.390302529957765e-15]
    pio2.extend([3.282003415807913e-22, 1.270655753080676e-29, 1.2293330898111133e-36])
    pio2.extend([2.7337005381646456e-44, 2.1674168387780482e-51])
    two24 = 16777216.0
    // x = z * 2^e0 with z in [2^23, 2^24)
    z = x
    e0 = 0
    while z >= 4.722366482869645e21:
        z *= 2.3283064365386963e-10
        e0 += 32
    while z >= two24:
        z *= 0.5
        e0 += 1
    while z < 8388608.0:
        z *= 2.0
        e0 -= 1
    // x's 53 bits as three whole numbers of 24 bits, the last ones dropped if zero
    tx = []
    for i in range(2):
        t = z - z % 1.0
        tx.append(t)
        z = (z - t) * two24
    tx.append(z)
    nx = 3
    while tx[nx - 1] == 0.0:
        nx -= 1

    jk = 4
    jx = nx - 1
    jv = (e0 - 3) / 24
    if jv < 0:
        jv = 0
    q0 = e0 - 24 * (jv + 1)
    f = []
    q = []
    fq = []
    iq = []
    for i in range(20):
        f.append(0.0)
        q.append(0.0)
        fq.append(0.0)
        iq.append(0.0)
    j = jv - jx
    for i in range(jx + jk + 1):
        if j >= 0:
            f[i] = ipio2[j]
        j += 1
    for i in range(jk + 1):
        fw = 0.0
        for j in range(jx + 1):
            fw += tx[j] * f[jx + i - j]
        q[i] = fw

    jz = jk
    n = 0.0
    ih = 0
    done = false
    while not done:
        // distill q into iq, last first
        z = q[jz]
        i = 0
        j = jz
        while j > 0:
            fw = z / two24
            fw -= fw % 1.0
            v = z - two24 * fw
            iq[i] = v - v % 1.0
            z = q[j - 1] + fw
            i += 1
            j -= 1
        // the whole quarter turns, modulo 8, and what is left over
        z *= 2.0 ** q0
        v = z * 0.125
        z -= 8.0 * (v - v % 1.0)
        n = z - z % 1.0
        z -= n
        ih = 0
        if q0 > 0:
            v = iq[jz - 1] / 2.0 ** (24 - q0)
            v -= v % 1.0
            n += v
            iq[jz - 1] -= v * 2.0 ** (24 - q0)
            v = iq[jz - 1] / 2.0 ** (23 - q0)
            if v >= 1.0:
                ih = 1
        elif q0 == 0:
            if iq[jz - 1] >= 8388608.0:
                ih = 1
        elif z >= 0.5:
            ih = 2
        if ih > 0:
            // more than half a quarter turn is left, so take the next turn and keep 1 - q
            n += 1.0
            carry = false
            for i in range(jz):
                if carry:
                    iq[i] = 16777215.0 - iq[i]
                elif iq[i] != 0.0:
                    carry = true
                    iq[i] = 16777216.0 - iq[i]
            if q0 == 1:
                iq[jz - 1] = iq[jz - 1] % 8388608.0
            elif q0 == 2:
                iq[jz - 1] = iq[jz - 1] % 4194304.0
            if ih == 2:
                z = 1.0 - z
                if carry:
                    z -= 2.0 ** q0
        // a rest that cancelled to zero needs more bits of 2/pi
        done = true
        if z == 0.0:
            zero = true
            for i in range(jk, jz):
                if iq[i] != 0.0:
                    zero = false
            if zero:
                k = 1
                while iq[jk - k] == 0.0:
                    k += 1
                for i in range(jz + 1, jz + k + 1):
                    f[jx + i] = ipio2[jv + i]
                    fw = 0.0
                    for j in range(jx + 1):
                        fw += tx[j] * f[jx + i - j]
                    q[i] = fw
                jz += k
                done = false

    // drop the zero chunks at the end, or split what is left into chunks
    if z == 0.0:
        jz -= 1
        q0 -= 24
        while iq[jz] == 0.0:
            jz -= 1
            q0 -= 24
    else:
        z *= 2.0 ** -q0
        if z >= two24:
            fw = z / two24
            fw -= fw % 1.0
            v = z - two24 * fw
            iq[jz] = v - v % 1.0
            jz += 1
            q0 += 24
            iq[jz] = fw
        else:
            iq[jz] = z - z % 1.0
    // the chunks as floats, times pi/2
    fw = 2.0 ** q0
    i = jz
    while i >= 0:
        q[i] = fw * iq[i]
        fw *= 5.960464477539063e-08
        i -= 1
    i = jz
    while i >= 0:
        fw = 0.0
        k = 0
        while k <= jk and k <= jz - i:
            fw += pio2[k] * q[i + k]
            k += 1
        fq[jz - i] = fw
        i -= 1
    // the sum, then what the sum lost
    fw = 0.0
    i = jz
    while i >= 0:
        fw += fq[i]
        i -= 1
    y0 = fw
    fw = fq[0] - fw
    for i in range(1, jz + 1):
        fw += fq[i]
    y1 = fw
    if ih != 0:
        y0 = -y0
        y1 = -y1
    ret (n % 8.0, y0, y1)

enum Shape:
    Circle(float)
    Rect(float, float)
    Empty

fn area(s: Shape) -> float:
    match s:
        case Shape.Circle(r):
            ret 3.0 * r * r
        case Shape.Rect(w, h):
            ret w * h
        case Shape.Empty:
            ret 0.0

for s in [Shape.Circle(1.0), Shape.Rect(2.0, 3.0), Shape.Empty]:
    print(s, area(s))

fn find(names: list[str], name: str) -> option[int]:
    for i in range(names.len()):
        if names[i] == name:
            ret some(i)
    ret none

names = ["ada", "bo"]
match find(names, "bo"):
    case some(i):
        print("bo is at", i)
    case none:
        print("bo is missing")
print(find(names, "cy"), find(names, "ada").unwrap_or(-1))

enum Command:
    Move(dx: int, dy: int)
    Say(text: str)
    Quit

fn run(c: Command) -> str:
    match c:
        case Command.Move(dx=0, dy=0):
            ret "stay"
        case Command.Move(dx, dy):
            ret "move by {dx}, {dy}"
        case Command.Say(text="hi" | "hello"):
            ret "greet"
        case Command.Say(text):
            ret "say {text}"
        case Command.Quit:
            ret "stop"

for c in [Command.Move(dy=2, dx=1), Command.Move(dx=0, dy=0), Command.Say(text="hi"), Command.Quit]:
    print(c, run(c))

fn size(n: int) -> str:
    match n:
        case 0:
            ret "none"
        case 1 | 2 | 3:
            ret "a few"
        case _:
            ret "many"

print(size(0), size(2), size(10))

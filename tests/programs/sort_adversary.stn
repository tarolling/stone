// inputs built by McIlroy's adversary against sort's quicksort, which take it past its depth
// limit, so it finishes with heapsort

fn ordered(xs: list[int]) -> bool:
    for i in range(1, xs.len()):
        if xs[i] < xs[i - 1]:
            ret false
    ret true

fn ordered_strs(xs: list[str]) -> bool:
    for i in range(1, xs.len()):
        if xs[i] < xs[i - 1]:
            ret false
    ret true

fn checksum(xs: list[int]) -> int:
    total = 0
    for x in xs:
        total = total * 31 + x
    ret total

// spread far enough apart that every byte differs, so the list is too short for radix
fn spread(text: str) -> list[int]:
    xs = []
    for word in text.split():
        xs.append(int(word) * 13000000000000000 - 4600000000000000000)
    ret xs

// the same order as strings, which always go to the quicksort
fn words(text: str) -> list[str]:
    xs = []
    for word in text.split():
        n = int(word)
        xs.append("w" + str(n / 100) + str(n / 10 % 10) + str(n % 10))
    ret xs

long = "0 2 4 8 7 9 700 13 12 14 700 700 18 19 700 23 22 24 700 700 28 29 700 33 32 34 700 700 38 39 700 43 42 44 700 700 48 49 700 53 52 54 700 700 58 59 700 63 62 64 700 700 68 69 700 73 72 74 700 700 78 79 700 83 82 84 700 700 88 89 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 3 1 5 10 15 17 20 25 27 30 35 37 40 45 47 50 55 57 60 65 67 70 75 77 80 85 87 90 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700 700
// trait values: values of any type that implements a trait, called through its type's methods

trait Shape:
    fn area(self) -> float
    fn name(self) -> str:
        ret "shape"
    fn describe(self) -> str:
        ret "{self.name()} of area {self.area()}"

struct Circle:
    r: float

struct Square:
    side: float

struct Labeled[T]:
    label: str
    value: T

impl Shape for Circle:
    fn area(self) -> float:
        ret 3.0 * self.r * self.r
    fn name(self) -> str:
        ret "circle"

impl Shape for Square:
    fn area(self) -> float:
        ret self.side * self.side

impl Shape for int:
    fn area(self) -> float:
        ret float(self)
    fn name(self) -> str:
        ret "int"

impl Shape for Labeled:
    fn area(self) -> float:
        ret 0.5
    fn name(self) -> str:
        ret self.label

struct Scene:
    main: Shape
    rest: list[Shape]

fn total(shapes: list[Shape]) -> float:
    t = 0.0
    for s in shapes:
        t += s.area()
    ret t

fn biggest(a: Shape, b: Shape) -> Shape:
    if a.area() >= b.area():
        ret a
    ret b

fn pick(n: int) -> Shape:
    if n == 0:
        ret Circle(r=1.0)
    if n == 1:
        ret Square(side=2.0)
    ret n

fn total_of[T: Shape](xs: list[T]) -> float:
    t = 0.0
    for x in xs:
        t += x.area()
    ret t

fn boxed[T: Shape](x: T) -> Shape:
    ret x

shapes = [Shape(Circle(r=1.0)), Square(side=2.0), 7, Labeled(label="tag", value=[1, 2])]
print(total(shapes))
for s in shapes:
    print(s.describe())
print(shapes)
print(shapes[0], "{shapes[1]}", str(shapes[2]), shapes[3].display())
print(biggest(Circle(r=1.0), Square(side=1.0)))
print(pick(0).area(), pick(1).area(), pick(5).area())
print(total([Circle(r=2.0), Square(side=3.0)]))
print(total_of(shapes), total_of([Circle(r=1.0)]))
print(boxed(Square(side=4.0)).area(), boxed(shapes[0]).area())

scene = Scene(main=Circle(r=1.0), rest=[Square(side=1.0), 3])
scene.rest.append(Circle(r=0.5))
scene.main = Square(side=5.0)
print(scene.main.area(), total(scene.rest))
print(scene)

m = {"a": Shape(Circle(r=1.0))}
m["b"] = Square(side=2.0)
for k in m:
    print(k, m[k].name())

maybe = some(Shape(Square(side=3.0)))
print(maybe.unwrap().area(), maybe)

s = Shape(Circle(r=1.0))
s = Square(side=2.0)
print(s.name(), s.area())

things = [display(1), "two", [3.0], Circle(r=4.0), shapes[2]]
print(things)
for t in things:
    print(t)

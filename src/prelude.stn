// The prelude, which every program is linked with, so its names need no `use`. Its variants are
// written alone, as `some(x)`, `none`, and `less`, and print that way too. Its functions are
// linked as `prelude.<name>`, so a program's names never clash with them.
//
// Builtins such as `find`, `pop`, `get`, and `os.env` make options by tag, so `none` stays the
// first variant and `some` the second, `cmp` on builtin types makes orderings by tag, so `less`,
// `equal`, and `greater` stay in that order, and `parse_int` and `parse_float` make results by
// tag, so `ok` stays before `err`. `os.run` fills an `output` by field order, so `status`,
// `stdout`, and `stderr` stay in that order.

// A value that may be missing: `some(x)` holds one, and `none` holds nothing.
pub enum option[T]:
    none
    some(T)

// How one value compares with another, which `cmp` gives.
pub enum ordering:
    less
    equal
    greater

// The outcome of something that may fail: `ok(x)` holds its value, and `err(e)` the error. `?`
// after a result gives the value of an `ok`, and returns an `err` from the function it is in.
pub enum result[T, E]:
    ok(T)
    err(E)

// What a command `os.run` ran did: the status it exited with (or minus the number of the signal
// that stopped it), and the text it wrote to stdout and to stderr.
pub struct output:
    status: int
    stdout: str
    stderr: str

// Values that `==` and `!=` compare. Every type `==` compares part by part implements it, and a
// struct may define what `==` means for it instead, as in `impl eq for Point:`.
pub trait eq:
    fn eq(self, other: Self) -> bool

// Values in an order, which `<`, `<=`, `>`, `>=`, and `sort` use. `int`, `float`, and `str`
// implement it, and a struct may too, as in `impl ord for Version:`.
pub trait ord:
    fn cmp(self, other: Self) -> ordering

// Values that `print`, `str`, and a string's `{value}` write as text. Every type implements it,
// and a struct may say how it is written instead, as in `impl display for Point:`, which `print`
// and `str` then use wherever a `Point` appears, inside lists and other values too.
pub trait display:
    fn display(self) -> str

// How a value of type `T` becomes a value of the implementing type, which `Type(value)` calls,
// as in `Fahrenheit(c)` after `impl from[Celsius] for Fahrenheit:`. Every type converts from
// itself, every value to `str` through `display`, and an `int` to a `float`.
pub trait from[T]:
    fn from(value: T) -> Self

// How a value of type `T` may become a value of the implementing type, which `Type(value)`
// calls, giving the error if it cannot, as `int("12")` gives `ok(12)` and `int("x")` an `err`.
// A `float` or a `str` may become an `int`, a `str` a `float`, and a `list[int]` `bytes`.
pub trait try_from[T]:
    fn try_from(value: T) -> result[Self, str]

// Sorts a list of values of a type that implements `ord`, for `xs.sort()` on a list of anything
// but `int`, `float`, and `str`. It merges ever longer runs, taking from the right run only when
// its value is less than the left's, so equal values keep their order, and every program gets
// the same list from the same `cmp`.
fn sort[T: ord](xs: list[T]) -> list[T]:
    n = xs.len()
    width = 1
    while width < n:
        out = []
        start = 0
        while start < n:
            mid = start + width
            if mid > n:
                mid = n
            end = mid + width
            if end > n:
                end = n
            i = start
            j = mid
            while i < mid and j < end:
                if xs[j] < xs[i]:
                    out.append(xs[j])
                    j += 1
                else:
                    out.append(xs[i])
                    i += 1
            while i < mid:
                out.append(xs[i])
                i += 1
            while j < end:
                out.append(xs[j])
                j += 1
            start = end
        xs = out
        width *= 2
    ret xs

// The list of what `f` gives for each value of `xs`, in order, for `xs.map(f)`.
fn map[T, U](xs: list[T], f: fn(T) -> U) -> list[U]:
    out = []
    for x in xs:
        out.append(f(x))
    ret out

// The values of `xs` that `keep` gives true for, in order, for `xs.filter(keep)`.
fn filter[T](xs: list[T], keep: fn(T) -> bool) -> list[T]:
    out = []
    for x in xs:
        if keep(x):
            out.append(x)
    ret out

// Whether `test` gives true for any value of `xs`, trying them in order until one does, for
// `xs.any(test)`.
fn any[T](xs: list[T], test: fn(T) -> bool) -> bool:
    for x in xs:
        if test(x):
            ret true
    ret false

// Whether `test` gives true for every value of `xs`, trying them in order until one does not,
// for `xs.all(test)`.
fn all[T](xs: list[T], test: fn(T) -> bool) -> bool:
    for x in xs:
        if not test(x):
            ret false
    ret true

// Sorts `xs` by what `key` gives for each value, for `xs.sort_by_key(key)`. It calls `key` once
// for each value, in order, then merges ever longer runs of their positions as `sort` merges
// values, so values with equal keys keep their order.
fn sort_by_key[T, K: ord](xs: list[T], key: fn(T) -> K) -> list[T]:
    keys = []
    order = []
    n = 0
    for x in xs:
        keys.append(key(x))
        order.append(n)
        n += 1
    width = 1
    while width < n:
        out = []
        start = 0
        while start < n:
            mid = start + width
            if mid > n:
                mid = n
            end = mid + width
            if end > n:
                end = n
            i = start
            j = mid
            while i < mid and j < end:
                if keys[order[j]] < keys[order[i]]:
                    out.append(order[j])
                    j += 1
                else:
                    out.append(order[i])
                    i += 1
            while i < mid:
                out.append(order[i])
                i += 1
            while j < end:
                out.append(order[j])
                j += 1
            start = end
        order = out
        width *= 2
    sorted = []
    for position in order:
        sorted.append(xs[position])
    // `xs.sort_by_key(key)` moves the list in for its sorted copy, so this owns it, as `sort` does
    xs = sorted
    ret xs

// The first value of `xs` with the least key, or none if `xs` is empty, for
// `xs.min_by_key(key)`, which calls `key` once for each value, in order.
fn min_by_key[T, K: ord](xs: list[T], key: fn(T) -> K) -> option[T]:
    if xs.len() == 0:
        ret none
    best = 0
    best_key = key(xs[0])
    for i in range(1, xs.len()):
        k = key(xs[i])
        if k < best_key:
            best = i
            best_key = k
    ret some(xs[best])

// The last value of `xs` with the greatest key, or none if `xs` is empty, for
// `xs.max_by_key(key)`, so it is the value `sort_by_key` puts last.
fn max_by_key[T, K: ord](xs: list[T], key: fn(T) -> K) -> option[T]:
    if xs.len() == 0:
        ret none
    best = 0
    best_key = key(xs[0])
    for i in range(1, xs.len()):
        k = key(xs[i])
        if k >= best_key:
            best = i
            best_key = k
    ret some(xs[best])

// The lesser of `a` and `b`, for `a.min(b)`: `b` only if it is less than `a`, so of equal values
// it is `a`, as `math.min` keeps the first.
fn min[T: ord](a: T, b: T) -> T:
    if b < a:
        ret b
    ret a

// The greater of `a` and `b`, for `a.max(b)`: `b` only if it is greater than `a`, so of equal
// values it is `a`, as `math.max` keeps the first.
fn max[T: ord](a: T, b: T) -> T:
    if b > a:
        ret b
    ret a

// Whether `lo` is at most `hi` (never for a nan bound), then `x` brought into the range from `lo`
// to `hi`, for `x.clamp(lo, hi)`, which turns bounds out of order into a runtime error. A tuple
// rather than an option, so a call allocates nothing.
fn clamp[T: ord](x: T, lo: T, hi: T) -> tuple[bool, T]:
    if not (lo <= hi):
        ret (false, x)
    if x < lo:
        ret (true, lo)
    if x > hi:
        ret (true, hi)
    ret (true, x)

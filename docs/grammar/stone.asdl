-- ASDL's 4 builtin types are:
-- identifier, int, string, constant

module stone
{
    mod = Module(stmt* body)

    stmt = FunctionDef(identifier name, bool public, type_param* type_params,
                       arguments args, stmt* body, type? returns)
          | EnumDef(identifier name, bool public, type_param* type_params,
                    variant* variants)
          | StructDef(identifier name, bool public, type_param* type_params,
                      field* fields)
          -- each method is a FunctionDef; trait_name is the trait before 'for', if any
          | ImplDef(identifier name, trait_name? trait_name, stmt* methods)
          -- each method is a FunctionDef, whose body is empty if it is written without one
          | TraitDef(identifier name, bool public, stmt* methods)

          | Return(expr? value)

          | Assign(expr* targets, expr value)
          | AugAssign(expr target, operator op, expr value)

          -- use 'orelse' because else is a keyword in target languages
          | For(expr target, expr iter, stmt* body, stmt* orelse)
          | While(expr test, stmt* body, stmt* orelse)
          | If(expr test, stmt* body, stmt* orelse)

          | Match(expr subject, match_case* cases)

          | Expr(expr value)
          | Use(identifier* path, identifier? alias)
          | Break | Continue

    expr = BoolOp(boolop op, expr* values)
         | BinOp(expr left, operator op, expr right)
         | UnaryOp(unaryop op, expr operand)
         | Compare(expr left, cmpop* ops, expr* comparators)
         | Call(expr func, expr* args, keyword* keywords)
         | JoinedStr(expr* values)
         | Constant(constant value, string? kind)

         | Attribute(expr value, identifier attr, expr_context ctx)
         | Try(expr value)
         | Subscript(expr value, expr slice, expr_context ctx)
         | Name(identifier id, expr_context ctx)
         | List(expr* elts, expr_context ctx)
         | Dict(expr* keys, expr* values)
         | Tuple(expr* elts, expr_context ctx)

         -- can appear only in Subscript
         | Slice(expr? lower, expr? upper, expr? step)

    expr_context = Load | Store

    boolop = And | Or

    operator = Add | Subtract | Multiply | Divide | Modulo | Power

    unaryop = Invert | Not | UAdd | USub

    cmpop = Eq | NotEq | Lt | LtE | Gt | GtE | In | NotIn

    arguments = (arg* args)

    arg = (identifier arg, type? annotation)

    -- a type parameter of a generic function, struct, or enum, such as T in enum Tree[T]:
    type_param = (identifier name, trait_name* bounds)

    -- a trait, maybe through its module, such as geo.Shape
    trait_name = (identifier name)

    variant = (identifier name, type* fields)

    field = (identifier name, type annotation)

    -- a named value in a call, such as x=1.0 in Point(x=1.0, y=2.0)
    keyword = (identifier arg, expr value)

    match_case = (pattern pattern, stmt* body)

    pattern = MatchWildcard
            | MatchName(identifier name)
            -- path names the variant, such as Shape.Circle, some, or none
            | MatchVariant(identifier* path, pattern* fields)

    type = Int | Float | Bool | Str | List(type elem) | Map(type key, type value)
         | Tuple(type* elts)
         -- a struct, such as Point, an enum, such as Shape, option[T], or a type parameter, such as T
         | Named(identifier name, type* args)
         -- a function, such as fn(int) -> bool, with no ret for one that returns no value
         | Function(type* params, type? ret)
}
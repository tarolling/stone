// the lists a loop computes on stay on the device for every turn, and come back once

fn decay(x: list[float], v: list[float], k: int) -> list[float]:
    for _ in range(k):
        x = x * 0.5 + v
    ret x

fn grow(s: list[int], t: list[int]) -> list[int]:
    for i in range(1, 5):
        s = s * 3 + t
        t = t - s
    ret s

print(decay([16.0, 8.0, 4.0], [1.0, 2.0, 3.0], 4))
print(grow([1, 2], [3, 4]))

// at the top level
x = [1.0, 2.0, 3.0, 4.0]
v = [0.5, 0.5, 0.5, 0.5]
turns = 3
w = v
for _ in range(turns):
    x = x * 2.0 - v
    w = x + v
print(x)
print(w)

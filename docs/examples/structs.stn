use math

struct Point;
    x: float
    y: float

struct Path;
    name: str
    points: list[Point]

fn length(path: Path) -> float;
    total = 0.0
    for i in range(1, path.points.len());
        a = path.points[i - 1]
        b = path.points[i]
        total += math.sqrt((b.x - a.x) ** 2 + (b.y - a.y) ** 2)
    ret total

walk = Path(name="walk", points=[Point(x=0.0, y=0.0)])
walk.points.append(Point(x=3.0, y=4.0))
print(walk.name, length(walk))

back = walk
back.name = "back"
back.points.append(Point(y=0.0, x=0.0))
back.points[1].x += 1.0
print(walk)
print(back)
print(back.name, length(back))

// compiled code computes a trigonometric value once, and a sine and a cosine of the same value
// together, which must give the same bits as computing each where it is written
use math

fn both(x: float) -> float:
    ret math.sin(x) * 2.0 + math.cos(x) - math.sin(x)

fn branches(x: float, flag: bool) -> float:
    s = math.sin(x)
    if flag:
        ret s + math.cos(x)
    ret s - math.cos(x) * 3.0

fn moved(x: float) -> float:
    a = math.sin(x)
    x = x + 1.0
    // a cosine of the new x, which shares nothing with the sine of the old one
    ret a + math.cos(x) + math.sin(x)

inf = 1e308 * 10.0
nan = inf - inf
for x in [0.0, -0.0, 1e-9, 1.2e-8, 0.3, -0.7, 1.0, 2.5, -4.0, 100.0, 1e6, -1647099.0, 1e22, nan]:
    print(x, both(x), branches(x, true), branches(x, false), moved(x))
    print(math.sin(x), math.cos(x), math.tan(x), math.sin(x) == math.sin(x))

// an int argument, a constant, and the same value in a loop
n = 7
print(math.sin(n), math.cos(n), math.sin(3), math.cos(3), math.atan2(n, n), math.atan2(n, n))
angle = 0.25
total = 0.0
for i in range(100):
    t = float(i) * angle
    total += math.sin(t) * math.cos(t) + math.cos(angle) * math.sin(angle)
print(total)

// cmp gives the prelude's ordering, written and printed alone, on ints, floats, and strings

print(1.cmp(2), 2.cmp(2), 3.cmp(2))
print("apple".cmp("banana"), "b".cmp("a"), "".cmp(""))
nan = float("nan")
inf = float("inf")
// floats are in the order sort uses: -0.0 before 0.0, and nan after every other float
print((-0.0).cmp(0.0), 0.0.cmp(-0.0), 0.0.cmp(0.0))
print(nan.cmp(inf), inf.cmp(nan), nan.cmp(nan), 1.5.cmp(-inf))
print(-0.0 < 0.0, nan < inf)

fn describe(o: ordering) -> str:
    match o:
        case less:
            ret "before"
        case equal:
            ret "same"
        case greater:
            ret "after"

for pair in [(1, 2), (5, 5), (9, 3)]:
    a, b = pair
    print(a, describe(a.cmp(b)))
o = 1.cmp(2)
print(o == less, o != greater, [less, equal, greater], some(equal))

// a bounded function compares any ordered type
fn max_of[T: ord](xs: list[T]) -> T:
    best = xs[0]
    for x in xs:
        if x.cmp(best) == greater:
            best = x
    ret best

fn same[T: eq](a: T, b: T) -> bool:
    ret a == b and a.eq(b)

print(max_of([3, 7, 2]), max_of(["pear", "fig"]), max_of([1.5, nan, 2.5]))
print(same((1, "a"), (1, "a")), same(some(2), none), 3.eq(3))

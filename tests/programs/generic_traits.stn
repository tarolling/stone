// a trait with type parameters, which a type implements once for each set of them
struct V:
    x: int

trait combine[R]:
    fn combine(self, other: R) -> Self
    fn twice(self, other: R) -> Self:
        ret self.combine(other).combine(other)

impl combine[int] for V:
    fn combine(self, other: int) -> Self:
        ret V(x=self.x + other)

impl combine[V] for V:
    fn combine(self, other: V) -> Self:
        ret V(x=self.x * 10 + other.x)

// a builtin type may implement a trait of the program's
impl combine[str] for int:
    fn combine(self, other: str) -> Self:
        ret self + other.len()

// a generic struct's block may give the trait the struct's own parameter
struct Box[T]:
    items: list[T]

impl combine[T] for Box:
    fn combine(self, other: T) -> Self:
        items = self.items
        items.append(other)
        ret Box(items=items)

fn inc[T: combine[int]](x: T) -> T:
    ret x.combine(1)

fn plus[T: combine[U], U](x: T, y: U) -> T:
    ret x.combine(y).twice(y)

fn pick(xs: list[int]) -> int:
    ret xs[0]

v = V(x=1)
print(v.combine(2), v.combine(V(x=2)), v.twice(3), v.twice(V(x=4)))
print(inc(v), plus(v, 5), plus(v, V(x=6)))
print(3.combine("abcd"), plus(3, "ab"))
print(Box(items=[1]).combine(2).twice(3), plus(Box(items=["a"]), "b"))
// the argument's type is known only after the call is checked
print(v.combine(pick([7])))

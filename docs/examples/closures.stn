fn over(xs: list[int], limit: int) -> list[int]:
    ret xs.filter(|x| x > limit)

fn adder(n: int) -> fn(int) -> int:
    ret |x: int| x + n

print(over([4, 9, 2, 7], 5))

k = 10
f = |x: int| x * k
k = 20
print(f(2), k)

add3 = adder(3)
add10 = adder(10)
print(add3(1), add10(1), [1, 2].map(add3))

grid = [[1, 2], [3]]
print(grid.map(|row| row.map(|x| x * row.len())))

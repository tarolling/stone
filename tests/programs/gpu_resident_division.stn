// a zero divisor on a later turn of a loop whose lists are on the device is reported where the
// interpreter reports it, from lists brought back first

fn run(x: list[float], d: list[float]) -> list[float]:
    for _ in range(5):
        d = d - 1.0
        x = x / d
    ret x

print(run([1.0, 2.0], [3.5, 4.0]))

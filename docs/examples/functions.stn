// fn opens a function, and ret returns from it
fn area(width: int, height: int) -> int;
    ret width * height

print(area(3, 4))

// functions can call themselves, and be called before they are defined
print(fib(10))

fn fib(n: int) -> int;
    if n < 2;
        ret n
    ret fib(n - 1) + fib(n - 2)

// a function without -> returns none
fn greet(name: str);
    print("hi " + name)

print(greet("ada"))

// assigning inside a function makes a local; other names are globals
counter = 10
fn bump() -> int;
    counter = 1
    ret counter
print(bump(), counter)

fn read_counter() -> int;
    ret counter
print(read_counter())

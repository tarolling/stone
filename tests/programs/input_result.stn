// input returns ok of each line, an empty one too, and err once the input is over
fn read_number() -> result[int, str]:
    line = input()?
    ret int(line)

print(input())
print(input())
print(read_number())
match input():
    case ok(line):
        print("got", line)
    case err(message):
        print("error:", message)
print(eof(), input())
print(read_number())
print(input("prompt> ").unwrap())

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "stone",
  "scopeName": "source.stone",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#function-definition" },
    { "include": "#enum-definition" },
    { "include": "#struct-definition" },
    { "include": "#type-annotation" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#builtin" },
    { "include": "#function-call" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.stone",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.stone",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.stone" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.stone" } },
      "patterns": [
        { "name": "constant.character.escape.stone", "match": "\\\\(x[0-9a-fA-F]{2}|[\"'\\\\ntr])" },
        { "name": "invalid.illegal.escape.stone", "match": "\\\\." },
        { "name": "constant.character.escape.stone", "match": "\\{\\{|\\}\\}" },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.stone",
      "contentName": "source.stone",
      "begin": "\\{",
      "end": "\\}|$",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.stone" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.stone" } },
      "patterns": [
        { "include": "#braces" },
        { "include": "$self" }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}|$",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.stone" } },
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.stone" } },
      "patterns": [
        { "include": "#braces" },
        { "include": "$self" }
      ]
    },
    "function-definition": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.stone" },
        "2": { "name": "entity.name.function.stone" }
      }
    },
    "enum-definition": {
      "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.enum.stone" },
        "2": { "name": "entity.name.type.enum.stone" }
      }
    },
    "struct-definition": {
      "match": "\\b(struct|impl|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.stone" },
        "2": { "name": "entity.name.type.struct.stone" }
      }
    },
    "type-annotation": {
      "match": "(->|:)\\s*((?:(?:list|map|tuple|option|result)\\[)*(?:int|float|bool|str|socket|listener)(?:\\]|,\\s*(?:(?:list|map|tuple|option|result)\\[)*(?:int|float|bool|str|socket|listener))*)(?![A-Za-z0-9_(])",
      "captures": {
        "1": { "name": "punctuation.separator.annotation.stone" },
        "2": { "name": "support.type.stone" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "variable.language.self.stone",
          "match": "\\b(self|Self)\\b"
        },
        {
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.stone" },
            "2": { "name": "entity.name.namespace.stone" }
          }
        },
        {
          "name": "keyword.control.import.stone",
          "match": "\\b(as)\\b"
        },
        {
          "name": "storage.modifier.stone",
          "match": "\\b(pub)\\b"
        },
        {
          "name": "keyword.control.stone",
          "match": "\\b(if|elif|else|while|for|in|break|cont|ret|match|case)\\b"
        },
        {
          "name": "keyword.operator.logical.stone",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.stone",
      "match": "\\b(true|false|none|less|equal|greater)\\b"
    },
    "number": {
      "name": "constant.numeric.integer.stone",
      "match": "\\b[0-9]+\\b"
    },
    "builtin": {
      "name": "support.function.builtin.stone",
      "match": "\\b(print|eprint|len|range|append|some|ok|err)\\b(?=\\s*\\()"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.stone" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.augmented.stone",
          "match": "\\*\\*=|\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.stone",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.stone",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.stone",
          "match": "\\*\\*|\\+|-|\\*|/|%|\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.stone",
          "match": ":(?=\\s*(//.*)?$)"
        },
        {
          "name": "punctuation.separator.comma.stone",
          "match": ","
        }
      ]
    }
  }
}

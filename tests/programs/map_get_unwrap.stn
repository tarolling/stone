// a value from get, unwrapped at once, with counted values and defaults
fn count(words: list[str]) -> map[str, int]:
    counts = {}
    for w in words:
        counts[w] = counts.get(w).unwrap_or(0) + 1
    ret counts

counts = count(["a", "b", "a", "c", "a"])
print(counts)
names = {1: "one", 2: "two"}
print(names.get(1).unwrap_or("none"))
print(names.get(3).unwrap_or("none"))
greeting = "hi"
print(names.get(2).unwrap_or(greeting) + names.get(4).unwrap_or(greeting))
lists = {"x": [1, 2]}
xs = lists.get("x").unwrap_or([])
xs.append(3)
print(xs)
print(lists)
pairs = {"p": (1, "q")}
print(pairs.get("p").unwrap_or((0, "")))
print(pairs.get("z").unwrap_or((0, "")))
print(names.get(2).unwrap())
print(names.get(5).unwrap())

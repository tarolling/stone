// str gives the text print writes
print(str(42) + "|" + str(-9223372036854775807 - 1) + "|" + str(0))
print(str(1.0) + "|" + str(0.1 + 0.2) + "|" + str(1e16) + "|" + str(-0.0) + "|" + str(1e-05))
print(str(float("nan")) + "|" + str(float("-inf")) + "|" + str(2.5))
print(str(true) + "|" + str(false) + "|" + str("text"))
print(str(12).len(), str(int(str(7)) * 6))

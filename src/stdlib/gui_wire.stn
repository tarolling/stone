// Numbers as bytes, least significant first, as the display protocols of the `gui` module write
// them, which only stone's own modules may use.

// `xs` with `value`'s two bytes after it, least significant first.
pub fn put16(xs: list[int], value: int) -> list[int]:
    xs.append(value % 256)
    xs.append(value / 256 % 256)
    ret xs

// `xs` with `value`'s four bytes after it, least significant first.
pub fn put32(xs: list[int], value: int) -> list[int]:
    xs = put16(xs, value % 65536)
    ret put16(xs, value / 65536 % 65536)

// The values of `data`'s bytes.
pub fn byte_list(data: bytes) -> list[int]:
    values = []
    for b in data:
        values.append(b)
    ret values

// `xs` with `data` after it, padded with zeros to a multiple of four bytes.
pub fn put_bytes(xs: list[int], data: bytes) -> list[int]:
    for b in data:
        xs.append(b)
    for _ in range(pad(data.len())):
        xs.append(0)
    ret xs

// The bytes that pad `n` bytes to a multiple of four.
pub fn pad(n: int) -> int:
    ret (4 - n % 4) % 4

// The two bytes at `at` of `data`, least significant first.
pub fn get16(data: bytes, at: int) -> int:
    ret data[at] + data[at + 1] * 256

// The two bytes at `at` of `data` as a signed number.
pub fn get16s(data: bytes, at: int) -> int:
    value = get16(data, at)
    if value >= 32768:
        ret value - 65536
    ret value

// The four bytes at `at` of `data`, least significant first.
pub fn get32(data: bytes, at: int) -> int:
    ret get16(data, at) + get16(data, at + 2) * 65536

// The screen's pixels `logical` pixels take at the scale `scale`, to the nearest.
pub fn physical(logical: int, scale: float) -> int:
    ret int(float(logical) * scale + 0.5).unwrap_or(0)

// The logical pixels `physical` pixels of the screen make at the scale `scale`, to the nearest,
// for a size.
pub fn logical(physical: int, scale: float) -> int:
    ret int(float(physical) / scale + 0.5).unwrap_or(0)

// The logical pixel the screen's pixel `at` falls in at the scale `scale`, counted from the
// window's inside, which may be left of it or above it, so negative.
pub fn logical_point(at: int, scale: float) -> int:
    exact = float(at) / scale
    whole = int(exact).unwrap_or(0)
    if float(whole) > exact:
        whole -= 1
    ret whole

// How far a canvas `size` logical pixels across reaches into a window `logical` logical pixels
// and `physical` of the screen's across: all of it for a canvas as big as the window.
pub fn reach(size: int, logical: int, physical: int) -> int:
    if logical <= 0:
        ret size
    ret size * physical / logical

// The scale the X resources `resources` set with `Xft.dpi`, 96 being 100%, or 0.0 if they set
// none from 0.5 to 8.
pub fn resource_scale(resources: str) -> float:
    for line in resources.splitlines():
        if line.startswith("Xft.dpi:"):
            scale = float(line[8:].strip()).unwrap_or(0.0) / 96.0
            if scale >= 0.5 and scale <= 8.0:
                ret scale
    ret 0.0

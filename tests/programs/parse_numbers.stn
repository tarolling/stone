// int and float read numbers from strings, ignoring whitespace at either end
print(int("42").unwrap(), int("  -7 ").unwrap(), int("+0012").unwrap(), int(input().unwrap()).unwrap())
print(int("9223372036854775807").unwrap(), int("-9223372036854775808").unwrap())
print(float("2.5").unwrap(), float(" -.5 ").unwrap(), float("3.").unwrap(), float("1e3").unwrap(), float("1E-2").unwrap(), float(input().unwrap()).unwrap())
print(float("6.02e+23").unwrap(), float("1e999").unwrap(), float("-1e999").unwrap(), float("1e-999").unwrap())
print(float("inf").unwrap(), float("-Infinity").unwrap(), float("NaN").unwrap(), float("0.1").unwrap() + float("0.2").unwrap())
print(float("123456789012345678901234567890").unwrap(), float("4.9e-324").unwrap())
// numbers still convert as before
print(int(2.9).unwrap(), float(3))
total = 0
for word in "10 20 30".split():
    total = total + int(word).unwrap()
print(total)

// nested list indexing: multiplying two matrices filled from a generator
fn matrix(n: int, seed: int) -> list[list[int]]:
    rows = []
    x = seed
    for i in range(n):
        row = []
        for j in range(n):
            x = (x * 1103515245 + 12345) % 2147483648
            row.append(x / 2097152)
        rows.append(row)
    ret rows

fn multiply(a: list[list[int]], b: list[list[int]], n: int) -> list[list[int]]:
    c = []
    for i in range(n):
        row = []
        for j in range(n):
            total = 0
            for k in range(n):
                total += a[i][k] * b[k][j]
            row.append(total)
        c.append(row)
    ret c

fn checksum(c: list[list[int]], n: int) -> int:
    total = 0
    for i in range(n):
        for j in range(n):
            total += c[i][j] * (i + j + 1)
    ret total

n = int(args()[0])
print(checksum(multiply(matrix(n, 1), matrix(n, 2), n), n))

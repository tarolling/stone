// list appends and indexed loads and stores: counting primes with a sieve
fn count_primes(limit: int) -> int:
    is_prime = []
    for i in range(limit + 1):
        is_prime.append(1)
    is_prime[0] = 0
    is_prime[1] = 0
    p = 2
    while p * p <= limit:
        if is_prime[p] == 1:
            m = p * p
            while m <= limit:
                is_prime[m] = 0
                m += p
        p += 1
    count = 0
    for i in range(limit + 1):
        count += is_prime[i]
    ret count

print(count_primes(int(args()[0]).unwrap()))

// slicing a string picks bytes like slicing a list picks elements
s = "hello, world"
print(s[1:4], s[7:], s[:5], s[-5:], s[:-7], s[:])
print(s[::2], s[1::3], s[::-1], s[10:2:-2], s[-1:-4:-1])
print("[" + s[5:5] + "]", "[" + s[20:] + "]", "[" + s[4:1] + "]", "[" + ""[::-1] + "]")

// bounds from variables
i = 3
n = s.len()
print(s[i:i + 2], s[n - 3:n], s[i:], s[:i])

// whole characters can be sliced with a step of 1
word = "naïve"
print(word[2:4], word[:2], word[4:], word.len())

// a slice of a slice, and of a list element
print(s[2:10][1:3], ["abc", "def"][1][1:])

// the builtin methods of results, and parsing that returns a result
fn check(n: int) -> result[int, str]:
    if n < 0:
        ret err("negative: " + str(n))
    ret ok(n * 2)

good = check(4)
bad = check(-1)
print(good.is_ok(), good.is_err(), bad.is_ok(), bad.is_err())
print(good.unwrap(), good.unwrap_or(0), bad.unwrap_or(0), bad.unwrap_err())
print(good.ok(), good.err(), bad.ok(), bad.err())

// counted values, which the methods hand out references to
fn words(n: int) -> result[list[str], str]:
    if n == 0:
        ret err("none at all")
    out = []
    for i in range(n):
        out.append("w" + str(i))
    ret ok(out)

w = words(2)
grown = w.unwrap()
grown.append("x")
print(grown, w, words(0).unwrap_or(["-"]), words(0).unwrap_err() + "!")
print(w.ok(), words(0).err(), words(1).err().is_none())

// parse_int and parse_float give the error int() and float() would stop with
for text in ["42", " -7\n", "1.5", "", "99999999999999999999", "+0"]:
    print(text.parse_int())
for text in ["2.5", "-1e3", "inf", "nan", "x", ".", "1e999"]:
    print(text.parse_float())
total = 0
for text in "3 x 4 5.0 -2".split():
    match text.parse_int():
        case ok(n):
            total += n
        case err(message):
            print(message)
print(total)

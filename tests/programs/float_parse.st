def zeros(n);
    text = ""
    for i in range(n);
        text = text + "0"
    ret text

// an exact tie rounds to even, unless a digit far past the first 800 breaks it
tie = "9007199254740993." + zeros(900)
print(float(tie), float(tie + "1"), float(tie + "e0"), float(tie + "1e0"))
print(float("0." + zeros(400) + "1e400"), float("1" + zeros(700) + "e-700"))
print(float("2.-324"))

// random digit strings, longer than any float needs
seed = 98765
def next(seed);
    seed = seed * 6364136223846793005 % 9223372036854775807 + 1442695040888963407
    if seed < 0;
        seed = -(seed + 1)
    ret seed

for i in range(400);
    text = ""
    length = 0
    seed = next(seed)
    count = seed % 30 + 1
    for k in range(count);
        seed = next(seed)
        text = text + str(seed % 10)
    seed = next(seed)
    text = text + "e" + str(seed % 680 - 350)
    print(text, float(text))

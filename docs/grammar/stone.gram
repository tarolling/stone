# PEG grammar for stone



# ========================= START OF THE GRAMMAR =========================

# stone comments run from '//' to the end of the line and are dropped by the lexer, along with blank
# lines, so neither ever produces NEWLINE, INDENT, or DEDENT.

# NUMBER is an int literal such as 42, 0xff, 0o17, or 0b1010, or a float literal such as 1.5,
# 1e3, or 2.5e-3. A float needs a digit after its '.' and after its 'e' and optional sign, so 1.
# lexes as NUMBER '.'. A '_' may stand between two digits or right after a base prefix, as in
# 1_000_000 or 0x_ff.

# General grammatical elements and rules:
#
# * Strings with double quotes (") denote SOFT KEYWORDS
# * Strings with single quotes (') denote KEYWORDS
# * Upper case names (NAME) denote tokens in the Grammar/Tokens file
#
# Grammar Syntax:
#
# rule_name: expression
#   Optionally, a type can be included right after the rule name, which
#   specifies the return type of the C or Python function corresponding to the
#   rule:
# rule_name[return_type]: expression
#   If the return type is omitted, then a std::any::Any is returned in Rust.
# e1 e2
#   Match e1, then match e2.
# e1 | e2
#   Match e1 or e2.
#   The first alternative can also appear on the line after the rule name for
#   formatting purposes. In that case, a | must be used before the first
#   alternative, like so:
#       rule_name[return_type]:
#            | first_alt
#            | second_alt
# ( e )
#   Match e (allows also to use other operators in the group like '(e)*')
# [ e ] or e?
#   Optionally match e.
# e*
#   Match zero or more occurrences of e.
# e+
#   Match one or more occurrences of e.
# s.e+
#   Match one or more occurrences of e, separated by s. The generated parse tree
#   does not include the separator. This is otherwise identical to (e (s e)*).
# &e
#   Succeed if e can be parsed, without consuming any input.
# !e
#   Fail if e can be parsed, without consuming any input.
# ~
#   Commit to the current alternative, even if it fails to parse.
# &&e
#   Eager parse e. The parser will not backtrack and will immediately
#   fail with SyntaxError if e cannot be parsed.
#

# STARTING RULES
# ==============

program[mod]:
    | [statements] EOF 

# GENERAL STATEMENTS
# ==================

statements[vec_stmt]:
    | statement+ 

statement[stmt]:
    | compound_stmt
    | simple_stmts 

simple_stmts[vec_stmt]:
    | simple_stmt NEWLINE

# NOTE: assignment MUST precede expression, else parsing a simple assignment
# will throw a SyntaxError.
simple_stmt:
    | assignment
    | aug_assignment
    | expressions 
    | return_stmt
    | use_stmt
    | assert_stmt
    | const_def
    | 'break'
    | 'cont' 

compound_stmt:
    | function_def
    | enum_def
    | struct_def
    | impl_def
    | trait_def
    | match_stmt
    | if_stmt
    | for_stmt
    | while_stmt
    | test_def

# SIMPLE STATEMENTS
# =================

assignment:
    | (star_targets '=' )+ expressions !'=' 

# `x op= v` is `x = x op v`, except that the target's indexes are evaluated once
aug_assignment:
    | single_target augassign expressions

single_target:
    | single_subscript_attribute_target
    | NAME

augassign:
    | '+=' | '-=' | '*=' | '/=' | '%=' | '**=' | '&=' | '|=' | '^=' | '<<=' | '>>='

return_stmt:
    | 'ret' [expressions] 

# the message runs only if the test fails
assert_stmt:
    | 'assert' expression [',' expression]

# only at the top level of a file; the value is evaluated when the program is built, from
# literals, operators, and other constants
const_def:
    | ['pub'] 'const' NAME '=' expressions

# only valid at the top level of a file, which the checker enforces
use_stmt:
    | 'use' NAME ('.' NAME)* ['as' NAME]

# COMPOUND STATEMENTS
# ===================

# Common elements
# ---------------

block:
    | NEWLINE INDENT statements DEDENT 
    | simple_stmts

# Test blocks
# -----------

# only at the top level of a file, and `test` is a keyword only here, so it stays a name
# anywhere else; the description is a string without values, unique in its file
test_def:
    | "test" STRING ':' block

# Function definitions
# --------------------

function_def:
    | ['pub'] 'fn' NAME [type_params] '(' [parameters] ')' ['->' type] ':' block 

# the type parameters of a generic function, struct, or enum, such as [T] in
# fn first[T](xs: list[T]) -> T: or [A, B] in struct Pair[A, B]:
type_params:
    | '[' ','.type_param+ [','] ']' 

# a parameter's bounds name the traits its types implement, as in [T: Shape + Named]
type_param:
    | NAME [':' '+'.trait_name+]

# a generic trait's name takes its type arguments, as in from[int]
trait_name:
    | '.'.NAME+ ['[' ','.type+ [','] ']']

# Function parameters
# -------------------

parameters:
    | ','.param+

# the checker requires every parameter's type; the parser accepts a missing one
param:
    | NAME [':' type] 

# Types
# -----

# a name is int, float, bool, str, bytes, socket, or listener, or else a type parameter in scope,
# a struct, or an enum, which the checker looks up, or 'option' '[' type ']'; 'none' is not a type
type:
    | 'list' '[' type ']'
    | 'map' '[' type ',' type [','] ']'
    | 'set' '[' type ']'
    | 'tuple' '[' type (',' type)+ [','] ']'
    | 'fn' '(' [','.type+ [',']] ')' ['->' type]
    | NAME ('.' NAME)* ['[' ','.type+ [','] ']']

# Enum definitions
# ----------------

enum_def:
    | ['pub'] 'enum' NAME [type_params] ':' NEWLINE INDENT variant+ DEDENT

# a variant's values are all named, as in Rect(w: float, h: float), or all unnamed
variant:
    | NAME ['(' (','.variant_field+ | ','.type+) [','] ')'] NEWLINE

variant_field:
    | NAME ':' type

# Struct definitions
# ------------------

struct_def:
    | ['pub'] 'struct' NAME [type_params] ':' NEWLINE INDENT field+ DEDENT

field:
    | NAME ':' type NEWLINE

# Impl blocks
# -----------

# methods take 'self', without a type, as their first parameter; the others are associated
# functions, called on the struct; with a trait name and 'for', the block implements that trait
# for the type after 'for'
impl_def:
    | 'impl' [trait_name 'for'] NAME ':' NEWLINE INDENT function_def+ DEDENT

# Trait definitions
# -----------------

# a method without a body is one every implementing type defines; one with a body is a default
trait_def:
    | ['pub'] 'trait' NAME [type_params] ':' NEWLINE INDENT trait_method+ DEDENT

trait_method:
    | function_def
    | 'fn' NAME [type_params] '(' [parameters] ')' ['->' type] NEWLINE

# Match statement
# ---------------

match_stmt:
    | 'match' expression ':' NEWLINE INDENT case_block+ DEDENT

case_block:
    | 'case' as_pattern ':' block

# binds the whole value the pattern matched, as in Circle() as c
as_pattern:
    | or_pattern 'as' NAME
    | or_pattern

or_pattern:
    | '|'.pattern+

# a single NAME without parentheses binds, and '_' matches anything; any other is a variant,
# as in Shape.Circle(r), some(x), or Shape.Empty, or, for a trait value, the type it holds,
# as in Circle(r), Circle(), or int(n)
pattern:
    | 'none'
    | ['-'] NUMBER | STRING | 'true' | 'false'
    | NAME ('.' NAME)* ['(' [','.pattern_field+ [',']] ')']

# a named variant's or a struct's values are matched by name, as in Shape.Rect(w=0, h), where
# a NAME alone that names a field is short for NAME '=' NAME, and fields left out match anything
pattern_field:
    | NAME '=' as_pattern
    | as_pattern

# If statement
# ------------

if_stmt:
    | 'if' expression ':' block elif_stmt 
    | 'if' expression ':' block [else_block] 
elif_stmt:
    | 'elif' expression ':' block elif_stmt 
    | 'elif' expression ':' block [else_block] 
else_block:
    | 'else' ':' block 

# While statement
# ---------------

while_stmt:
    | 'while' expression ':' block

# For statement
# -------------

# the iterable is a list, a str (its characters), bytes (its ints), a map (its keys), or
# range(n) or range(a, b), which counts without building one
for_stmt:
    | 'for' star_targets 'in' ~ expressions ':' block

# EXPRESSIONS
# -----------

# values separated by commas, as in `x = 1, 2`, are an error that says a tuple needs
# parentheses, as in `x = (1, 2)`
expressions:
    | expression

expression:
    | disjunction
    | lambdef

# a function written where it is used, whose body is one expression on the same line; it may
# use its own parameters, whose types may be left out, and the variables around it, of which it
# captures copies
lambdef:
    | '|' [parameters] '|' expression

named_expressions:
    | ','.expression+ [','] 

disjunction:
    | conjunction ('or' conjunction )+ 
    | conjunction

conjunction:
    | inversion ('and' inversion )+ 
    | inversion

inversion:
    | 'not' inversion 
    | comparison

# Comparison operators
# --------------------

# chains such as a < b <= c mean a < b and b <= c, evaluating b once; the checker rejects a
# chain with 'in' or 'not in' in it
comparison:
    | bitwise_or (compare_op bitwise_or)*

compare_op:
    | '=='
    | '!='
    | '<'
    | '<='
    | '>'
    | '>='
    | 'in'
    | 'not' 'in'

# Bitwise operators
# -----------------

# as in Python, looser than arithmetic and tighter than comparisons, so a & b == c is
# (a & b) == c; a '|' here follows a value, so it never starts a lambdef
bitwise_or:
    | bitwise_xor ('|' bitwise_xor)*

bitwise_xor:
    | bitwise_and ('^' bitwise_and)*

bitwise_and:
    | shift_expr ('&' shift_expr)*

shift_expr:
    | sum (('<<'|'>>') sum)*

# Arithmetic operators
# --------------------

sum:
    | term ('+'|'-' term)* 

term:
    | factor ('*'|'/'|'%' factor)* 

factor:
    | '+' factor 
    | '-' factor 
    | '~' factor 
    | power

power:
    | primary '**' factor 
    | primary

# Primary elements
# ----------------

# Primary elements are things like "obj.something.something", "obj[something]", "obj(something)",
# "obj?", "obj" ...

primary:
    | atom ( '(' [arguments] ')' | '[' slices ']' | '.' NAME | '?' )* 

slices:
    | slice !',' 

slice:
    | [expression] ':' [expression] [':' [expression]]
    | expression 

atom:
    | NAME
    | 'true' 
    | 'false' 
    | 'none' 
    | strings
    | bytes
    | NUMBER
    | list
    | dict
    | tuple
    | group

# a tuple has at least two values, so `()` and `(x,)` are errors
tuple:
    | '(' expression (',' expression )+ [','] ')' 

group:
    | '(' expression ')' 

# LITERALS
# ========

strings:
    | (string)+ 

# a string with values in it is lexed as its pieces of text around them, as in `"a{x}b"`, which
# is STRING_START("a"), the tokens of `x`, then STRING_END("b"); a `:` that ends a value starts
# its format spec, lexed whole as FORMAT_SPEC, as `:.2f` in `"{x:.2f}"`
string[expr]:
    | STRING 
    | STRING_START value (STRING_MIDDLE value)* STRING_END

value[expr]:
    | expression FORMAT_SPEC
    | expression

# a bytes literal, BYTES as in `b"a\x00"`, written one after another to join
bytes: BYTES+

list:
    | '[' [named_expressions] ']' 

# `{}` is an empty map or set, which the checker tells by its use
dict:
    | '{' [kvpair (',' kvpair)* [',']] '}' 
    | '{' expression (',' expression)* [','] '}' 

kvpair:
    | expression ':' expression 

# FUNCTION CALL ARGUMENTS
# =======================

arguments:
    | args [','] &')' 

# named values come last, and only a struct takes them, as in `Point(x=1.0, y=2.0)`
args:
    | ','.(kwarg | expression)+

kwarg:
    | NAME '=' expression


# ASSIGNMENT TARGETS
# ==================

# Generic targets
# ---------------

# names separated by commas unpack a tuple, as in `q, r = divide(7, 2)`
star_targets:
    | star_target (',' star_target )* [','] 

star_target:
    | target_with_star_atom

target_with_star_atom:
    | t_primary '.' NAME !t_lookahead 
    | t_primary '[' slices ']' !t_lookahead 
    | star_atom

star_atom:
    | NAME 
    | '(' star_targets ')' 

single_subscript_attribute_target:
    | t_primary '.' NAME !t_lookahead 
    | t_primary '[' slices ']' !t_lookahead 

t_primary:
    | atom ( '[' slices ']' | '(' [arguments] ')' | '.' NAME )* &t_lookahead 

t_lookahead:
    | '('
    | '['
    | '.'

# ========================= END OF THE GRAMMAR ===========================

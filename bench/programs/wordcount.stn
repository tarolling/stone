// maps with string keys: counting how often each word appears
fn count_words(n: int, k: int) -> map[str, int]:
    counts = {}
    x = 1
    for i in range(n):
        x = (x * 1103515245 + 12345) % 2147483648
        word = str(x / 64 % k)
        counts[word] = counts.get(word).unwrap_or(0) + 1
    ret counts

fn checksum(counts: map[str, int], k: int) -> int:
    total = counts.len()
    for j in range(k):
        word = str(j)
        if counts.contains(word):
            total += counts[word] * (j % 7 + 1)
    ret total

k = int(args()[1]).unwrap()
print(checksum(count_words(int(args()[0]).unwrap(), k), k))

// a trait names methods that types implement
trait Shape:
    fn area(self) -> float
    fn name(self) -> str
    // a method with a body is a default, which a type keeps unless it defines its own
    fn describe(self) -> str:
        ret self.name() + " of area " + str(self.area())

struct Circle:
    r: float

struct Rect:
    w: float
    h: float

impl Shape for Circle:
    fn area(self) -> float:
        ret 3.0 * self.r * self.r
    fn name(self) -> str:
        ret "circle"

impl Shape for Rect:
    fn area(self) -> float:
        ret self.w * self.h
    fn name(self) -> str:
        ret "rect"

// [T: Shape] lets the function call Shape's methods on any type that implements it
fn total[T: Shape](xs: list[T]) -> float:
    t = 0.0
    for x in xs:
        t += x.area()
    ret t

print(Circle(r=1.0).describe())
print(total([Circle(r=1.0), Circle(r=2.0)]), total([Rect(w=2.0, h=3.0)]))

// builtin types can implement a trait too
impl Shape for int:
    fn area(self) -> float:
        ret float(self * self)
    fn name(self) -> str:
        ret "square of side " + str(self)

print(total([1, 2, 3]), 4.describe())

// eq and ord are traits of the prelude: == and < use them, and so does sort
struct Version:
    major: int
    minor: int

impl ord for Version:
    fn cmp(self, other: Self) -> ordering:
        if self.major != other.major:
            ret self.major.cmp(other.major)
        ret self.minor.cmp(other.minor)

vs = [Version(major=1, minor=10), Version(major=0, minor=9), Version(major=1, minor=2)]
vs.sort()
print(vs[0], vs[2].minor, vs[0] < vs[1], 3.cmp(5))

// display is how print, str, and "{x}" write a value, wherever it appears
impl display for Version:
    fn display(self) -> str:
        ret "v{self.major}.{self.minor}"

print(vs, "newest: {vs[2]}")

fn largest[T: ord](xs: list[T]) -> T:
    best = xs[0]
    for x in xs:
        if x > best:
            best = x
    ret best

print(largest([3, 9, 4]), largest(["pear", "fig"]), largest(vs).minor)

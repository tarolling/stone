// Sandbox: a falling-sand toy. Pour sand and water, wall them in, grow plants, and set fire to
// them: fire boils water into steam, which rises, cools, and rains back down.
//
// The left button paints the material picked in the bar (click it, or press 1 to 6), the right
// button erases, and the wheel changes the brush. Space pauses, c clears, r rebuilds the
// starting scene, and escape quits.
use gui
use random

// pixels per cell, the grid's size in cells, and the bars above and below it
CELL = 5
COLUMNS = 160
ROWS = 100
BAR = 36
FOOTER = 22

EMPTY = 0
SAND = 1
WATER = 2
WALL = 3
PLANT = 4
FIRE = 5
ERASE = 6
STEAM = 7

// pixels per material in the bar, and the colors of the cells' background, of the bars, and
// of what is picked
SWATCH = 86
BACKGROUND = gui.rgb(24, 24, 44)
PANEL = gui.rgb(22, 22, 30)
GOLD = gui.rgb(241, 194, 50)

// The color of a fresh cell of `kind`, before `shade` varies it.
fn base_color(kind: int) -> int:
    if kind == SAND:
        ret gui.rgb(222, 184, 110)
    if kind == WATER:
        ret gui.rgb(48, 112, 220)
    if kind == WALL:
        ret gui.rgb(112, 112, 124)
    if kind == PLANT:
        ret gui.rgb(54, 168, 72)
    if kind == FIRE:
        ret gui.rgb(255, 170, 40)
    if kind == STEAM:
        ret gui.rgb(196, 204, 220)
    ret gui.rgb(230, 60, 80)

// The name the bar shows for `kind`.
fn name_of(kind: int) -> str:
    names = ["empty", "sand", "water", "wall", "plant", "fire", "erase", "steam"]
    ret names[kind]

// `color` made lighter by `amount` in each channel, or darker if it is negative.
fn shade(color: int, amount: int) -> int:
    ret gui.rgb(color / 65536 + amount, color / 256 % 256 + amount, color % 256 + amount)

// How many turns a fresh cell of `kind` lasts, or 0 if it lasts forever.
fn lifetime(kind: int) -> int:
    if kind == FIRE:
        ret random.randint(30, 60)
    if kind == STEAM:
        ret random.randint(80, 220)
    ret 0

// The color of fire with `life` turns left: white hot at first, then yellow, orange, and red.
fn fire_color(life: int) -> int:
    heat = life * 7 + 30 + random.randint(-30, 30)
    ret gui.rgb(150 + heat, heat - 60, heat - 200)

// `c` with the cells under the square around `x`, `y` that reaches `radius` pixels from it
// (or none if `radius` is negative) painted over with the background.
fn wipe(c: gui.canvas, x: int, y: int, radius: int) -> gui.canvas:
    if radius < 0:
        ret c
    left = (x - radius).max(0) / CELL
    top = (y - BAR - radius).max(0) / CELL
    right = (x + radius) / CELL
    bottom = (y - BAR + radius) / CELL
    if right >= left and bottom >= top:
        c.rect(left * CELL, BAR + top * CELL, (right - left + 1) * CELL, (bottom - top + 1) * CELL, BACKGROUND)
    ret c

// -1 or 1, at random.
fn random_side() -> int:
    ret random.randint(0, 1) * 2 - 1

// Whether falling sand moves into a cell of `kind`, pushing it up.
fn sinks_into(kind: int) -> bool:
    ret kind == EMPTY or kind == WATER or kind == STEAM

struct sandbox:
    // each cell's material, color, and turns left, in rows from the top left
    kinds: list[int]
    colors: list[int]
    life: list[int]
    // the turn each cell last moved, so nothing moves twice in one turn
    stamps: list[int]
    turn: int
    material: int
    brush: int
    painting: bool
    erasing: bool
    mouse_x: int
    mouse_y: int
    paused: bool
    // turns per second, smoothed so the number does not flicker
    fps: float
    quit: bool
    // where the brush's outline is drawn and its radius in pixels (negative for nowhere), and
    // where it was drawn the turn before, which the picture still shows
    cursor_x: int
    cursor_y: int
    cursor_r: int
    old_x: int
    old_y: int
    old_r: int

// An empty sandbox with the starting scene in it.
fn new_sandbox() -> sandbox:
    cells = []
    for _ in range(COLUMNS * ROWS):
        cells.append(0)
    s = sandbox(kinds=cells, colors=cells, life=cells, stamps=cells, turn=0, material=SAND, brush=3, painting=false, erasing=false, mouse_x=-1, mouse_y=-1, paused=false, fps=60.0, quit=false, cursor_x=0, cursor_y=0, cursor_r=-1, old_x=0, old_y=0, old_r=-1)
    s.scene()
    ret s

impl sandbox:
    // The material at `x`, `y`, or a wall off the grid, so the edges hold everything in.
    fn at(self, x: int, y: int) -> int:
        if x < 0 or y < 0 or x >= COLUMNS or y >= ROWS:
            ret WALL
        ret self.kinds[y * COLUMNS + x]

    // Makes the cell at `x`, `y` a fresh cell of `kind`.
    fn put(self, x: int, y: int, kind: int):
        i = y * COLUMNS + x
        self.kinds[i] = kind
        self.colors[i] = shade(base_color(kind), random.randint(-16, 16))
        self.life[i] = lifetime(kind)
        self.stamps[i] = self.turn

    // Moves the cell at `x`, `y` by `dx`, `dy`, and what was there to where it was.
    fn swap(self, x: int, y: int, dx: int, dy: int):
        i = y * COLUMNS + x
        j = (y + dy) * COLUMNS + x + dx
        kind = self.kinds[i]
        self.kinds[i] = self.kinds[j]
        self.kinds[j] = kind
        color = self.colors[i]
        self.colors[i] = self.colors[j]
        self.colors[j] = color
        life = self.life[i]
        self.life[i] = self.life[j]
        self.life[j] = life
        self.stamps[i] = self.turn
        self.stamps[j] = self.turn

    // Empties every cell.
    fn clear(self):
        self.kinds = self.kinds * 0
        self.life = self.life * 0

    // Builds the starting scene: two ledges, a pool of water in a basin, a heap of sand about
    // to fall, and plants on the basin's rim.
    fn scene(self):
        self.clear()
        self.wall_line(14, 34, 64, 46)
        self.wall_line(150, 52, 98, 60)
        self.wall_line(40, 78, 40, 96)
        self.wall_line(40, 96, 118, 96)
        self.wall_line(118, 96, 118, 78)
        for y in range(84, 96):
            for x in range(41, 118):
                self.put(x, y, WATER)
        for y in range(2, 17):
            for x in range(28 - (y - 2) / 2, 38 + (y - 2) / 2):
                self.put(x, y, SAND)
        for x in range(100, 140):
            self.put(x, 56 - (x - 98) * 8 / 52 - 1, PLANT)
        for y in range(70, 78):
            self.put(39, y, PLANT)
            self.put(119, y, PLANT)

    // Draws a wall two cells thick from `x0`, `y0` to `x1`, `y1`.
    fn wall_line(self, x0: int, y0: int, x1: int, y1: int):
        steps = (x1 - x0).max(x0 - x1).max((y1 - y0).max(y0 - y1)).max(1)
        for t in range(steps + 1):
            x = x0 + (x1 - x0) * t / steps
            y = y0 + (y1 - y0) * t / steps
            self.put(x, y, WALL)
            if y + 1 < ROWS:
                self.put(x, y + 1, WALL)

    // Moves everything one turn: from the bottom row up, so falling things fall once, and
    // each row in the other direction from the last, so nothing drifts to one side.
    fn step(self):
        self.turn += 1
        for row in range(ROWS):
            y = ROWS - 1 - row
            backward = (y + self.turn) % 2 == 0
            for column in range(COLUMNS):
                x = column
                if backward:
                    x = COLUMNS - 1 - column
                i = y * COLUMNS + x
                kind = self.kinds[i]
                if kind == EMPTY or kind == WALL or self.stamps[i] == self.turn:
                    cont
                if kind == SAND:
                    self.fall(x, y)
                elif kind == WATER:
                    self.flow(x, y)
                elif kind == PLANT:
                    self.grow(x, y)
                elif kind == FIRE:
                    self.burn(x, y)
                elif kind == STEAM:
                    self.rise(x, y)

    // Sand falls straight down, or slides off a slope, and sinks slowly through water.
    fn fall(self, x: int, y: int):
        below = self.at(x, y + 1)
        if below == EMPTY or below == STEAM or below == WATER and random.random() < 0.5:
            self.swap(x, y, 0, 1)
            ret
        side = random_side()
        if sinks_into(self.at(x + side, y + 1)):
            self.swap(x, y, side, 1)
        elif sinks_into(self.at(x - side, y + 1)):
            self.swap(x, y, -side, 1)

    // Water falls like sand, and where it cannot it spreads up to three cells sideways, so a
    // pool levels out.
    fn flow(self, x: int, y: int):
        if self.at(x, y + 1) == EMPTY:
            self.swap(x, y, 0, 1)
            ret
        side = random_side()
        if self.at(x + side, y + 1) == EMPTY:
            self.swap(x, y, side, 1)
            ret
        if self.at(x - side, y + 1) == EMPTY:
            self.swap(x, y, -side, 1)
            ret
        reach = 0
        while reach < 3 and self.at(x + side * (reach + 1), y) == EMPTY:
            reach += 1
        if reach > 0:
            self.swap(x, y, side * reach, 0)

    // A plant drinks the water beside it, now and then, and grows into its place.
    fn grow(self, x: int, y: int):
        dx = random.randint(-1, 1)
        dy = random.randint(-1, 1)
        if self.at(x + dx, y + dy) == WATER and random.random() < 0.04:
            self.put(x + dx, y + dy, PLANT)

    // Fire burns where it is and throws flames up, which drift up as they fade. It sets the
    // plants around it alight and boils water into steam, which puts it out.
    fn burn(self, x: int, y: int):
        i = y * COLUMNS + x
        self.life[i] -= 1
        life = self.life[i]
        if life <= 0:
            self.kinds[i] = EMPTY
            ret
        quenched = false
        for dy in range(-1, 2):
            for dx in range(-1, 2):
                if dx != 0 or dy != 0:
                    wet = self.touch(x + dx, y + dy)
                    quenched = quenched or wet
        if quenched:
            self.kinds[i] = EMPTY
            ret
        self.colors[i] = fire_color(life)
        side = random.randint(-1, 1)
        if self.at(x + side, y - 1) != EMPTY:
            ret
        if life > 16 and random.random() < 0.3:
            self.put(x + side, y - 1, FIRE)
            self.life[i - COLUMNS + side] = life / 2
        elif life <= 16 or random.random() < 0.1:
            self.swap(x, y, side, -1)

    // What fire does to the cell at `x`, `y`: catches a plant alight, or boils water, which
    // puts the fire out (true).
    fn touch(self, x: int, y: int) -> bool:
        kind = self.at(x, y)
        if kind == PLANT and random.random() < 0.12:
            self.put(x, y, FIRE)
        elif kind == WATER:
            self.put(x, y, STEAM)
            ret true
        ret false

    // Steam drifts up and sideways until it cools, then condenses back into water.
    fn rise(self, x: int, y: int):
        i = y * COLUMNS + x
        self.life[i] -= 1
        if self.life[i] <= 0:
            self.put(x, y, WATER)
            ret
        side = random.randint(-1, 1)
        if self.at(x + side, y - 1) == EMPTY:
            self.swap(x, y, side, -1)
        elif self.at(x + side, y) == EMPTY:
            self.swap(x, y, side, 0)

    // The cell under the window's point `x`, `y`.
    fn cell(self, x: int, y: int) -> tuple[int, int]:
        ret (x / CELL, (y - BAR) / CELL)

    // Paints the brush's disc of cells around the window's point `x`, `y`: walls and plants
    // solid, the rest sprinkled so it pours, and nothing over what is already there.
    fn paint(self, x: int, y: int):
        if y < BAR:
            ret
        cx, cy = self.cell(x, y)
        r = self.brush
        erase = self.erasing or self.material == ERASE
        solid = self.material == WALL or self.material == PLANT
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                px = cx + dx
                py = cy + dy
                if dx * dx + dy * dy > r * r + r or px < 0 or py < 0 or px >= COLUMNS or py >= ROWS:
                    cont
                kind = self.kinds[py * COLUMNS + px]
                if erase:
                    self.kinds[py * COLUMNS + px] = EMPTY
                elif kind == EMPTY and (solid or random.random() < 0.3):
                    self.put(px, py, self.material)

    // Paints along the line from the window's point `x0`, `y0` to `x1`, `y1`, so a quick
    // stroke leaves no gaps.
    fn stroke(self, x0: int, y0: int, x1: int, y1: int):
        steps = ((x1 - x0).max(x0 - x1).max((y1 - y0).max(y0 - y1)) / CELL).max(1)
        for t in range(1, steps + 1):
            self.paint(x0 + (x1 - x0) * t / steps, y0 + (y1 - y0) * t / steps)

    // Does what the key `key` asks.
    fn press(self, key: str):
        if key == "space":
            self.paused = not self.paused
        elif key == "c":
            self.clear()
        elif key == "r":
            self.scene()
        elif key == "escape":
            self.quit = true
        elif key.len() == 1 and key >= "1" and key <= "6":
            self.material = int(key).unwrap_or(SAND)

    // Whether the bar on `c` is out of date: on a fresh canvas, after another material is
    // picked, or where the brush's outline crossed it. Each material's corner is gold only
    // while it is picked.
    fn bar_stale(self, c: gui.canvas) -> bool:
        if self.old_r >= 0 and self.old_y - self.old_r < BAR:
            ret true
        for kind in range(1, 7):
            gold = c.get(4 + (kind - 1) * SWATCH, 4).unwrap_or(0) == GOLD
            if gold != (kind == self.material):
                ret true
        ret false

    // Draws the bar of materials, if it is out of date, then the frame rate, the number of
    // moving cells, and the brush.
    fn draw_bar(self, c: gui.canvas, moving: int) -> gui.canvas:
        if self.bar_stale(c):
            c.rect(0, 0, c.width, BAR, PANEL)
            c.rect(0, BAR - 1, c.width, 1, gui.rgb(60, 60, 78))
            for kind in range(1, 7):
                left = 6 + (kind - 1) * SWATCH
                if kind == self.material:
                    c.rect(left - 2, 4, SWATCH - 6, BAR - 9, gui.rgb(58, 58, 80))
                    c.outline(left - 2, 4, SWATCH - 6, BAR - 9, GOLD)
                c.rect(left + 4, 10, 16, 16, base_color(kind))
                if kind == ERASE:
                    c.rect(left + 6, 12, 12, 12, PANEL)
                    c.line(left + 6, 12, left + 17, 23, base_color(kind))
                    c.line(left + 17, 12, left + 6, 23, base_color(kind))
                c.text(left + 26, 10, "{kind}", gui.rgb(130, 130, 150))
                c.text(left + 26, 19, name_of(kind), gui.rgb(230, 230, 240))
        left = 6 + 6 * SWATCH
        c.rect(left, 4, c.width - left, BAR - 6, PANEL)
        shown = int(self.fps).unwrap_or(0)
        rate = "{shown} fps  {moving} cells"
        c.text(c.width - gui.text_width(rate) - 10, 8, rate, GOLD)
        brush = "brush {self.brush}"
        if self.paused:
            brush = "paused  " + brush
        c.text(c.width - gui.text_width(brush) - 10, 20, brush, gui.rgb(150, 150, 170))
        ret c

    // Draws the line of hints below the grid, if it is not there or the brush's outline
    // crossed it.
    fn draw_footer(self, c: gui.canvas) -> gui.canvas:
        bottom = BAR + ROWS * CELL
        if c.get(0, bottom).unwrap_or(0) == PANEL and (self.old_r < 0 or self.old_y + self.old_r < bottom):
            ret c
        c.rect(0, bottom, c.width, c.height - bottom, PANEL)
        hint = "left paint   right erase   wheel brush   space pause   c clear   r reset"
        c.text(10, bottom + 7, hint, gui.rgb(150, 150, 170))
        ret c

impl gui.app for sandbox:
    fn update(self, e: gui.event):
        match e:
            case gui.event.tick(seconds):
                if seconds > 0.0:
                    self.fps = self.fps * 0.9 + 0.1 / seconds
                if self.painting:
                    self.paint(self.mouse_x, self.mouse_y)
                if not self.paused:
                    self.step()
                self.old_x = self.cursor_x
                self.old_y = self.cursor_y
                self.old_r = self.cursor_r
                self.cursor_x = self.mouse_x
                self.cursor_y = self.mouse_y
                self.cursor_r = -1
                if self.mouse_y >= BAR and self.mouse_y < BAR + ROWS * CELL:
                    self.cursor_r = self.brush * CELL + CELL / 2
            case gui.event.mouse_down(button, x, y):
                if y < BAR:
                    picked = (x - 6) / SWATCH + 1
                    if x >= 6 and picked <= ERASE:
                        self.material = picked
                else:
                    self.painting = true
                    self.erasing = button == "right"
                    self.paint(x, y)
                self.mouse_x = x
                self.mouse_y = y
            case gui.event.mouse_up(_, _, _):
                self.painting = false
            case gui.event.mouse_move(x, y):
                if self.painting:
                    self.stroke(self.mouse_x, self.mouse_y, x, y)
                self.mouse_x = x
                self.mouse_y = y
            case gui.event.scroll(steps):
                self.brush = (self.brush + steps).clamp(0, 12)
            case gui.event.key_down(key):
                self.press(key)
            case _:
                ret

    fn draw(self, c: gui.canvas) -> gui.canvas:
        // the canvas still shows the last turn, so once the cells the brush's outline crossed
        // are wiped, only a cell whose top left pixel is not its color is drawn again
        c = wipe(c, self.old_x, self.old_y, self.old_r)
        columns = COLUMNS.min((c.width + CELL - 1) / CELL)
        rows = ROWS.min((c.height - BAR + CELL - 1) / CELL)
        moving = 0
        for y in range(ROWS):
            top = BAR + y * CELL
            corner = top * c.width
            for x in range(COLUMNS):
                i = y * COLUMNS + x
                kind = self.kinds[i]
                color = BACKGROUND
                if kind != EMPTY:
                    color = self.colors[i]
                    if kind != WALL and kind != PLANT:
                        moving += 1
                if x < columns and y < rows and c.pixels[corner + x * CELL] != color:
                    c.rect(x * CELL, top, CELL, CELL, color)
        c = self.draw_bar(c, moving)
        c = self.draw_footer(c)
        c.circle(self.cursor_x, self.cursor_y, self.cursor_r, gui.rgb(250, 250, 255))
        ret c

    fn done(self) -> bool:
        ret self.quit

match gui.run("sandbox", COLUMNS * CELL, BAR + ROWS * CELL + FOOTER, new_sandbox()):
    case ok(_):
        print("closed")
    case err(reason):
        print("could not open a window:", reason)

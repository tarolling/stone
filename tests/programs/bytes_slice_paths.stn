// Slices of bytes along every path the runtime takes: the whole of them, which may share them,
// a run by step 1, which copies a block, and any other step, byte by byte, on short bytes and on
// bytes longer than the allocator's largest class.
fn long(n: int) -> bytes:
    text = "0123456789abcdef"
    while text.len() < n:
        text = text + text
    ret text[:n].bytes()

for data in [b"a\x00b\xffc", long(70000)]:
    n = data.len()
    whole = data[:]
    print(whole.len(), whole == data, data[0:n] == data, data[-n:] == data, data[:n + 5] == data)
    head = data[:3]
    middle = data[1:4]
    tail = data[n - 2:]
    print(head, middle, tail, data[2:2], data[n:], data[4:1])
    print(data[::2].len(), data[1::3][:4], data[::-1][:3], data[3:0:-1])
    // the whole slice outlives the bytes it came from
    kept = data[:]
    data = b""
    print(kept.len(), kept[0], kept[-1], data.len())

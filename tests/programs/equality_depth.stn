// comparing enum values nested more than 10000 levels deep stops the program
enum IntList:
    Nil
    Cons(int, IntList)

fn numbers(n: int) -> IntList:
    l = IntList.Nil
    for i in range(n):
        l = IntList.Cons(i, l)
    ret l

print(numbers(9999) == numbers(9999))
a = numbers(10000)
b = numbers(10000)
print("before")
print(a != b)

// structs and methods: simulating the orbits of the Sun and the four gas giants
use math

struct Body:
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    mass: float

impl Body:
    fn drift(self, dt: float):
        self.x += dt * self.vx
        self.y += dt * self.vy
        self.z += dt * self.vz

    fn kinetic(self) -> float:
        ret 0.5 * self.mass * (self.vx * self.vx + self.vy * self.vy + self.vz * self.vz)

fn advance(bodies: list[Body], dt: float, steps: int) -> list[Body]:
    n = bodies.len()
    for s in range(steps):
        for i in range(n):
            for j in range(i + 1, n):
                dx = bodies[i].x - bodies[j].x
                dy = bodies[i].y - bodies[j].y
                dz = bodies[i].z - bodies[j].z
                d2 = dx * dx + dy * dy + dz * dz
                mag = dt / (d2 * math.sqrt(d2))
                mj = bodies[j].mass * mag
                bodies[i].vx -= dx * mj
                bodies[i].vy -= dy * mj
                bodies[i].vz -= dz * mj
                mi = bodies[i].mass * mag
                bodies[j].vx += dx * mi
                bodies[j].vy += dy * mi
                bodies[j].vz += dz * mi
        for i in range(n):
            bodies[i].drift(dt)
    ret bodies

fn energy(bodies: list[Body]) -> float:
    e = 0.0
    n = bodies.len()
    for i in range(n):
        e += bodies[i].kinetic()
        for j in range(i + 1, n):
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            e -= bodies[i].mass * bodies[j].mass / math.sqrt(dx * dx + dy * dy + dz * dz)
    ret e

// sets the Sun moving so the system's total momentum is zero
fn offset_momentum(bodies: list[Body], solar_mass: float) -> list[Body]:
    px = 0.0
    py = 0.0
    pz = 0.0
    for b in bodies:
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    bodies[0].vx = -px / solar_mass
    bodies[0].vy = -py / solar_mass
    bodies[0].vz = -pz / solar_mass
    ret bodies

pi = 3.141592653589793
solar_mass = 4.0 * pi * pi
days = 365.24
// the Sun, then Jupiter, Saturn, Uranus, and Neptune
bodies = []
bodies.append(Body(x=0.0, y=0.0, z=0.0, vx=0.0, vy=0.0, vz=0.0, mass=solar_mass))
bodies.append(Body(x=4.84143144246472090e+00, y=-1.16032004402742839e+00, z=-1.03622044471123109e-01, vx=1.66007664274403694e-03 * days, vy=7.69901118419740425e-03 * days, vz=-6.90460016972063023e-05 * days, mass=9.54791938424326609e-04 * solar_mass))
bodies.append(Body(x=8.34336671824457987e+00, y=4.12479856412430479e+00, z=-4.03523417114321381e-01, vx=-2.76742510726862411e-03 * days, vy=4.99852801234917238e-03 * days, vz=2.30417297573763929e-05 * days, mass=2.85885980666130812e-04 * solar_mass))
bodies.append(Body(x=1.28943695621391310e+01, y=-1.51111514016986312e+01, z=-2.23307578892655734e-01, vx=2.96460137564761618e-03 * days, vy=2.37847173959480950e-03 * days, vz=-2.96589568540237556e-05 * days, mass=4.36624404335156298e-05 * solar_mass))
bodies.append(Body(x=1.53796971148509165e+01, y=-2.59193146099879641e+01, z=1.79258772950371181e-01, vx=2.68067772490389322e-03 * days, vy=1.62824170038242295e-03 * days, vz=-9.51592254519715870e-05 * days, mass=5.15138902046611451e-05 * solar_mass))
bodies = offset_momentum(bodies, solar_mass)
// energies scaled to ints, so C need not print floats the way stone does
print(int(energy(bodies) * 1000000000.0))
bodies = advance(bodies, 0.01, int(args()[0]))
print(int(energy(bodies) * 1000000000.0))

// int() drops the fraction and float() rounds to the nearest float
print(int(2.5), int(-2.5), int(0.999), int(-0.999), int(1e18))
print(float(3), float(-7), float(9007199254740993), float(0))
print(int(9.2e18), int(-9.223372036854775808e18))
print(float(2.5), int(7))
n = 10
print(float(n) / 4.0, int(float(n) / 4.0))

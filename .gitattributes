* text=auto

# golden test data is compared byte for byte, so keep line endings such as \r\n as written
*.in -text
*.out -text
*.err -text
*.args -text
*.env -text
*.stderr -text
**/*.files/** -text

# a Windows checkout keeps \n in sources too, which the formatter and the docs tests compare
*.stn text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.sh text eol=lf

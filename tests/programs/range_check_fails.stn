// a loop whose bound passes a list's length fails at the first index past it, after the same turns
fn dot(xs: list[int], ys: list[int], n: int) -> int:
    s = 0
    for i in range(n):
        s += xs[i] * ys[i]
    ret s

print(dot([1, 2, 3], [4, 5, 6, 7, 8], 3))
print(dot([1, 2, 3], [4, 5, 6, 7, 8], 5))
